@using DTOs
@using Domain.Model
@using API.Clients
@inject IJSRuntime JSRuntime

@if (showModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        @(mode == FormMode.Add ? "Agregar Bicicleta" : "Editar Bicicleta")
                    </h5>
                    <button type="button" class="btn-close" @onclick="Close"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="currentBicicleta" OnValidSubmit="HandleValidSubmit">
                        <DataAnnotationsValidator />

                        @if (mode == FormMode.Update)
                        {
                            <div class="mb-3">
                                <label class="form-label">Id</label>
                                <input type="text" class="form-control" value="@currentBicicleta.Id" readonly />
                            </div>
                        }

                        <div class="mb-3">
                            <label class="form-label">Marca *</label>
                            <InputText @bind-Value="currentBicicleta.Marca" class="form-control" />
                            @if (validationErrors.ContainsKey("Marca"))
                            {
                                <div class="text-danger small">@validationErrors["Marca"]</div>
                            }
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Modelo *</label>
                            <InputText @bind-Value="currentBicicleta.Modelo" class="form-control" />
                            @if (validationErrors.ContainsKey("Modelo"))
                            {
                                <div class="text-danger small">@validationErrors["Modelo"]</div>
                            }
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Categoría *</label>
                            <InputSelect @bind-Value="currentBicicleta.CategoriaId" class="form-select">
                                <option value="0">Seleccionar Categoría</option>
                                @if (categorias != null)
                                {
                                    @foreach (var categoria in categorias)
                                    {
                                        <option value="@categoria.Id">@categoria.Descripcion</option>
                                    }
                                }
                            </InputSelect>
                            @if (validationErrors.ContainsKey("Categoria"))
                            {
                                <div class="text-danger small">@validationErrors["Categoria"]</div>
                            }
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Sucursal *</label>
                            <InputSelect @bind-Value="currentBicicleta.SucursalId" class="form-select">
                                <option value="0">Seleccionar Sucursal</option>
                                @if (sucursales != null)
                                {
                                    @foreach (var sucursal in sucursales)
                                    {
                                        <option value="@sucursal.Id">@sucursal.Direccion</option>
                                    }
                                }
                            </InputSelect>
                            @if (validationErrors.ContainsKey("Sucursal"))
                            {
                                <div class="text-danger small">@validationErrors["Sucursal"]</div>
                            }
                        </div>

                        @* Selector de Estado: solo editable en modo Actualizar; en modo Agregar nace como Disponible *@
                        @if (mode == FormMode.Update)
                        {
                            <div class="mb-3">
                                <label class="form-label">Estado *</label>
                                <InputSelect @bind-Value="currentBicicleta.Estado" class="form-select">
                                    @foreach (var estado in Enum.GetValues<EstadoBicicleta>())
                                    {
                                        <option value="@estado">@estado</option>
                                    }
                                </InputSelect>
                            </div>
                        }
                        else
                        {
                            <div class="mb-3">
                                <label class="form-label">Estado Inicial</label>
                                <input type="text" class="form-control" value="Disponible" readonly />
                                <div class="form-text text-muted">Las bicicletas nuevas se registran automáticamente como Disponibles.</div>
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(errorMessage))
                        {
                            <div class="alert alert-danger">
                                @errorMessage
                            </div>
                        }

                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" @onclick="Close">Cancelar</button>
                            <button type="submit" class="btn btn-primary" disabled="@saving">
                                @if (saving)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                }
                                @(mode == FormMode.Add ? "Agregar" : "Actualizar")
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public EventCallback OnBicicletaChanged { get; set; }

    private bool showModal = false;
    private FormMode mode = FormMode.Add;
    private BicicletaDTO currentBicicleta = new BicicletaDTO();
    private bool saving = false;
    private string errorMessage = string.Empty;
    private Dictionary<string, string> validationErrors = new Dictionary<string, string>();
    private List<SucursalDTO>? sucursales;
    private List<CategoriaDTO>? categorias;

    public enum FormMode
    {
        Add,
        Update
    }

    public async Task ShowAddModal()
    {
        mode = FormMode.Add;
        currentBicicleta = new BicicletaDTO
        {
            Estado = EstadoBicicleta.Disponible
        };
        await LoadDropdowns();
        ClearValidationErrors();
        showModal = true;
        StateHasChanged();
    }

    public async Task ShowEditModal(BicicletaDTO bicicleta)
    {
        mode = FormMode.Update;
        // Clonamos para evitar mutaciones directas en la grilla antes de confirmar
        currentBicicleta = new BicicletaDTO
        {
            Id = bicicleta.Id,
            Marca = bicicleta.Marca,
            Modelo = bicicleta.Modelo,
            Estado = bicicleta.Estado,
            CategoriaId = bicicleta.CategoriaId,
            SucursalId = bicicleta.SucursalId,
        };
        await LoadDropdowns();
        ClearValidationErrors();
        showModal = true;
        StateHasChanged();
    }

    private async Task HandleValidSubmit()
    {
        if (!ValidateBicicleta())
            return;

        try
        {
            saving = true;
            errorMessage = string.Empty;

            if (mode == FormMode.Add)
            {
                await BicicletaApiClient.AddAsync(currentBicicleta);
            }
            else
            {
                await BicicletaApiClient.UpdateAsync(currentBicicleta);
            }

            await OnBicicletaChanged.InvokeAsync();
            Close();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            saving = false;
        }
    }

    private bool ValidateBicicleta()
    {
        ClearValidationErrors();
        bool isValid = true;

        if (string.IsNullOrWhiteSpace(currentBicicleta.Marca))
        {
            validationErrors["Marca"] = "La marca es requerida";
            isValid = false;
        }

        if (string.IsNullOrWhiteSpace(currentBicicleta.Modelo))
        {
            validationErrors["Modelo"] = "El modelo es requerido";
            isValid = false;
        }

        if (currentBicicleta.CategoriaId <= 0)
        {
            validationErrors["Categoria"] = "Debe seleccionar una categoría";
            isValid = false;
        }

        if (currentBicicleta.SucursalId <= 0)
        {
            validationErrors["Sucursal"] = "Debe seleccionar una sucursal";
            isValid = false;
        }

        StateHasChanged();
        return isValid;
    }

    private void ClearValidationErrors()
    {
        validationErrors.Clear();
        errorMessage = string.Empty;
    }

    private async Task LoadDropdowns()
    {
        try
        {
            var taskCategorias = CategoriaApiClient.GetAllAsync();
            var taskSucursales = SucursalApiClient.GetAllAsync();

            await Task.WhenAll(taskCategorias, taskSucursales);

            categorias = (await taskCategorias)?.ToList();
            sucursales = (await taskSucursales)?.ToList();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al cargar datos auxiliares: {ex.Message}";
        }
    }

    private void Close()
    {
        showModal = false;
        ClearValidationErrors();
        StateHasChanged();
    }
}
