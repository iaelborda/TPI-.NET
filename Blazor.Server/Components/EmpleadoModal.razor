@using DTOs
@using Domain.Model
@using API.Clients
@using System.Text.RegularExpressions

@if (showModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        @(mode == FormMode.Add ? "Agregar Empleado" : "Editar Empleado")
                    </h5>
                    <button type="button" class="btn-close" @onclick="Close"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="currentEmpleado" OnSubmit="HandleSubmit">
                        @if (mode == FormMode.Update)
                        {
                            <div class="mb-3">
                                <label class="form-label">Id</label>
                                <input type="text" class="form-control" value="@currentEmpleado.Id" readonly />
                            </div>
                        }

                        <div class="mb-3">
                            <label class="form-label">Legajo *</label>
                            @if (mode == FormMode.Add)
                            {
                                <InputNumber @bind-Value="currentEmpleado.Legajo" class="form-control" />
                            }
                            else
                            {
                                <input type="number" class="form-control" value="@currentEmpleado.Legajo" readonly />
                            }
                            @if (validationErrors.ContainsKey("Legajo"))
                            {
                                <div class="text-danger small">@validationErrors["Legajo"]</div>
                            }
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Tipo Documento *</label>
                            <InputSelect @bind-Value="currentEmpleado.TipoDocumento" class="form-select">
                                @foreach (var tipo in Enum.GetValues<TipoDocumento>())
                                {
                                    <option value="@tipo">@tipo</option>
                                }
                            </InputSelect>
                            @if (validationErrors.ContainsKey("TipoDocumento"))
                            {
                                <div class="text-danger small">@validationErrors["TipoDocumento"]</div>
                            }
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Documento *</label>
                            @if (mode == FormMode.Add)
                            {
                                <InputText @bind-Value="currentEmpleado.Documento" class="form-control" />
                            }
                            else
                            {
                                <input type="text" class="form-control" value="@currentEmpleado.Documento" readonly />
                            }
                            @if (validationErrors.ContainsKey("Documento"))
                            {
                                <div class="text-danger small">@validationErrors["Documento"]</div>
                            }
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Nombre *</label>
                            <InputText @bind-Value="currentEmpleado.Nombre" class="form-control" />
                            @if (validationErrors.ContainsKey("Nombre"))
                            {
                                <div class="text-danger small">@validationErrors["Nombre"]</div>
                            }
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Apellido *</label>
                            <InputText @bind-Value="currentEmpleado.Apellido" class="form-control" />
                            @if (validationErrors.ContainsKey("Apellido"))
                            {
                                <div class="text-danger small">@validationErrors["Apellido"]</div>
                            }
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Teléfono *</label>
                            <InputText @bind-Value="currentEmpleado.Telefono" class="form-control" />
                            @if (validationErrors.ContainsKey("Telefono"))
                            {
                                <div class="text-danger small">@validationErrors["Telefono"]</div>
                            }
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Sucursal *</label>
                            <InputSelect @bind-Value="currentEmpleado.SucursalId" class="form-select">
                                <option value="0">Seleccionar Sucursal</option>
                                @if (sucursales != null)
                                {
                                    @foreach (var sucursal in sucursales)
                                    {
                                        <option value="@sucursal.Id">@sucursal.Nombre</option>
                                    }
                                }
                            </InputSelect>
                            @if (validationErrors.ContainsKey("Sucursal"))
                            {
                                <div class="text-danger small">@validationErrors["Sucursal"]</div>
                            }
                        </div>

                        @if (!string.IsNullOrEmpty(errorMessage))
                        {
                            <div class="alert alert-danger">
                                @errorMessage
                            </div>
                        }

                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" @onclick="Close">Cancelar</button>
                            <button type="submit" class="btn btn-primary" disabled="@saving">
                                @if (saving)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                }
                                @(mode == FormMode.Add ? "Agregar" : "Actualizar")
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public EventCallback OnEmpleadoChanged { get; set; }

    private bool showModal = false;
    private FormMode mode = FormMode.Add;
    private EmpleadoDTO currentEmpleado = new EmpleadoDTO();
    private bool saving = false;
    private string errorMessage = string.Empty;
    private Dictionary<string, string> validationErrors = new Dictionary<string, string>();
    private List<SucursalDTO>? sucursales;

    public enum FormMode
    {
        Add,
        Update
    }

    public async Task ShowAddModal()
    {
        mode = FormMode.Add;
        currentEmpleado = new EmpleadoDTO
        {
            TipoDocumento = TipoDocumento.DNI
        };
        await LoadSucursales();
        ClearValidationErrors();
        showModal = true;
        StateHasChanged();
    }

    public async Task ShowEditModal(EmpleadoDTO empleado)
    {
        mode = FormMode.Update;
        currentEmpleado = new EmpleadoDTO
        {
            Id = empleado.Id,
            Legajo = empleado.Legajo,
            TipoDocumento = empleado.TipoDocumento,
            Documento = empleado.Documento,
            Nombre = empleado.Nombre,
            Apellido = empleado.Apellido,
            Telefono = empleado.Telefono,
            SucursalId = empleado.SucursalId,
            NombreSucursal = empleado.NombreSucursal
        };
        await LoadSucursales();
        ClearValidationErrors();
        showModal = true;
        StateHasChanged();
    }

    private async Task LoadSucursales()
    {
        try
        {
            sucursales = (await SucursalApiClient.GetAllAsync())?.ToList();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al cargar sucursales: {ex.Message}";
        }
    }

    private async Task HandleSubmit()
    {
        if (!ValidateEmpleado())
            return;

        try
        {
            saving = true;
            errorMessage = string.Empty;

            if (mode == FormMode.Add)
            {
                await EmpleadoApiClient.AddAsync(currentEmpleado);
            }
            else
            {
                await EmpleadoApiClient.UpdateAsync(currentEmpleado);
            }

            await OnEmpleadoChanged.InvokeAsync();
            Close();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            saving = false;
        }
    }

    private bool ValidateEmpleado()
    {
        ClearValidationErrors();
        bool isValid = true;

        if (currentEmpleado.Legajo <= 0)
        {
            validationErrors["Legajo"] = "El legajo debe ser un número entero mayor que 0";
            isValid = false;
        }

        if (string.IsNullOrWhiteSpace(currentEmpleado.Documento))
        {
            validationErrors["Documento"] = "El documento es requerido";
            isValid = false;
        }
        else if (!Regex.IsMatch(currentEmpleado.Documento, @"^\d+$"))
        {
            validationErrors["Documento"] = "El documento solo puede contener números";
            isValid = false;
        }
        else if (currentEmpleado.Documento.Length < 8)
        {
            validationErrors["Documento"] = "El documento debe tener al menos 8 dígitos";
            isValid = false;
        }
        else if (currentEmpleado.Documento.Length > 10)
        {
            validationErrors["Documento"] = "El documento debe tener menos de 10 caracteres";
            isValid = false;
        }

        if (string.IsNullOrWhiteSpace(currentEmpleado.Nombre))
        {
            validationErrors["Nombre"] = "El nombre es requerido";
            isValid = false;
        }

        if (string.IsNullOrWhiteSpace(currentEmpleado.Apellido))
        {
            validationErrors["Apellido"] = "El apellido es requerido";
            isValid = false;
        }

        if (string.IsNullOrWhiteSpace(currentEmpleado.Telefono))
        {
            validationErrors["Telefono"] = "El teléfono es requerido";
            isValid = false;
        }
        else if (!Regex.IsMatch(currentEmpleado.Telefono, @"^[0-9\-]+$"))
        {
            validationErrors["Telefono"] = "El teléfono solo puede contener números y guiones";
            isValid = false;
        }
        else
        {
            string soloNumeros = Regex.Replace(currentEmpleado.Telefono, @"\D", "");
            if (soloNumeros.Length != 10)
            {
                validationErrors["Telefono"] = "El teléfono debe tener 10 dígitos";
                isValid = false;
            }
        }

        if (currentEmpleado.SucursalId <= 0)
        {
            validationErrors["Sucursal"] = "Debe seleccionar una sucursal";
            isValid = false;
        }

        StateHasChanged();
        return isValid;
    }

    private void ClearValidationErrors()
    {
        validationErrors.Clear();
        errorMessage = string.Empty;
    }

    private void Close()
    {
        showModal = false;
        ClearValidationErrors();
        StateHasChanged();
    }
}
