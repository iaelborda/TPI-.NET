@page "/alquileres"
@using API.Clients
@using DTOs
@using Domain.Model
@using Blazor.Server.Components
@inject IJSRuntime JSRuntime
@inject IAuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Alquileres</PageTitle>

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <h3>Alquileres</h3>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @errorMessage
                    <button type="button" class="btn-close" @onclick="() => errorMessage = string.Empty"></button>
                </div>
            }

            @if (!string.IsNullOrEmpty(successMessage))
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @successMessage
                    <button type="button" class="btn-close" @onclick="() => successMessage = string.Empty"></button>
                </div>
            }

            <div class="d-flex flex-wrap gap-2 mb-3 align-items-end">
                @if (canAdd)
                {
                    <button class="btn btn-primary" @onclick="NuevoAlquiler">
                        <i class="fas fa-plus"></i> Agregar
                    </button>
                }

                @if (canReport)
                {
                    <button class="btn btn-success"
                            @onclick="GenerarReporte"
                            disabled="@generandoReporte">
                        <i class="fas fa-file-pdf me-1"></i>
                        @(generandoReporte ? "Generando..." : "Reporte de Alquileres")
                    </button>
                }
            </div>

            @if (canRead)
            {
                <div class="card mb-3 p-3 bg-light">
                    <div class="row g-2 align-items-end">
                        <div class="col-md-3">
                            <label class="form-label small">Fecha desde</label>
                            <input type="date" class="form-control"
                                   min="2000-01-01"
                                   max="@DateTime.Today.ToString("yyyy-MM-dd")"
                                   @bind="fechaDesde" />
                        </div>

                        <div class="col-md-3">
                            <label class="form-label small">Fecha hasta</label>
                            <input type="date" class="form-control"
                                   min="2000-01-01"
                                   max="@DateTime.Today.ToString("yyyy-MM-dd")"
                                   @bind="fechaHasta" />
                        </div>

                        <div class="col-md-3">
                            <label class="form-label small">Sucursal</label>
                            <select class="form-select" @bind="sucursalId">
                                <option value="0">Todas</option>
                                @foreach (var sucursal in sucursales)
                                {
                                    <option value="@sucursal.Id">@sucursal.Nombre</option>
                                }
                            </select>
                        </div>

                        <div class="col-md-3 d-flex gap-2">
                            <button class="btn btn-outline-secondary" @onclick="LimpiarFiltros" disabled="@loading">
                                <i class="fas fa-undo me-1"></i> Limpiar
                            </button>
                            <button class="btn btn-primary" @onclick="CargarAlquileres" disabled="@loading">
                                <i class="fas fa-search me-1"></i> Filtrar
                            </button>
                        </div>
                    </div>
                </div>
            }

            @if (loading)
            {
                <div class="d-flex justify-content-center">
                    <div class="spinner-border" role="status">
                        <span class="visually-hidden">Cargando...</span>
                    </div>
                </div>
            }
            else if (canRead)
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle">
                        <thead class="table-dark">
                            <tr>
                                <th>Id</th>
                                <th>Cliente</th>
                                <th>Empleado</th>
                                <th>Fecha</th>
                                <th>Estado</th>
                                <th>Total</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (alquileres.Any())
                            {
                                @foreach (var alquiler in alquileres)
                                {
                                    <tr @key="alquiler.Id">
                                        <td>@alquiler.Id</td>
                                        <td>@alquiler.ClienteNombre @alquiler.ClienteApellido</td>
                                        <td>@alquiler.EmpleadoApellido - Legajo: @alquiler.EmpleadoLegajo</td>
                                        <td>@alquiler.FechaAlquiler.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td>
                                            @if (alquiler.EstadoAlquiler == EstadoDeAlquiler.Activo)
                                            {
                                                <span class="badge bg-success">Activo</span>
                                            }
                                            else if (alquiler.EstadoAlquiler == EstadoDeAlquiler.Finalizado)
                                            {
                                                <span class="badge bg-secondary">Finalizado</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger">Cancelado</span>
                                            }
                                        </td>
                                        <td>@(alquiler.Detalles?.Sum(d => d.Subtotal).ToString("C2") ?? "$0,00")</td>
                                        <td class="text-nowrap">
                                            @if (canRead)
                                            {
                                                <button class="btn btn-sm btn-outline-primary me-1"
                                                        @onclick="() => EditarAlquiler(alquiler.Id)">
                                                    <i class="fas fa-edit"></i>
                                                    @(canUpdate ? "Ver / Editar" : "Ver")
                                                </button>
                                            }

                                            @if (canUpdate &&
                                                 alquiler.EstadoAlquiler != EstadoDeAlquiler.Cancelado &&
                                                 alquiler.Detalles != null &&
                                                 alquiler.Detalles.Count > 0 &&
                                                 alquiler.Detalles.All(d => d.HoraFin.HasValue) &&
                                                 !alquileresConPago.Contains(alquiler.Id))
                                            {
                                                <a class="btn btn-sm btn-success me-1"
                                                   href="@($"pagos?alquilerId={alquiler.Id}")">
                                                    <i class="fas fa-dollar-sign"></i> Cobrar
                                                </a>
                                            }

                                            @if (canDelete)
                                            {
                                                <button class="btn btn-sm btn-outline-danger"
                                                        @onclick="() => EliminarAlquiler(alquiler.Id)">
                                                    <i class="fas fa-trash"></i> Eliminar
                                                </button>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="7" class="text-center text-muted py-3">
                                        No hay alquileres para los filtros seleccionados.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@if (mostrarModal)
{
    <AlquilerModal @key="alquilerSeleccionado"
                   AlquilerId="alquilerSeleccionado"
                   OnCerrar="CerrarModal"
                   OnGuardado="AlquilerGuardado" />
}

@code {
    private List<AlquilerDTO> alquileres = new();
    private List<SucursalDTO> sucursales = new();

    private bool loading = true;
    private bool mostrarModal;
    private bool generandoReporte;
    private int? alquilerSeleccionado;
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;

    private DateTime fechaDesde = DateTime.Today.AddMonths(-2);
    private DateTime fechaHasta = DateTime.Today;
    private int sucursalId;

    private bool canRead;
    private bool canAdd;
    private bool canUpdate;
    private bool canDelete;
    private bool canReport;

    private HashSet<int> alquileresConPago = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (!await AuthService.IsAuthenticatedAsync())
            {
                Navigation.NavigateTo("/login");
                return;
            }

            await LoadPermissions();

            if (!canRead)
            {
                errorMessage = "No tiene permisos para ver alquileres.";
                return;
            }

            sucursales = (await SucursalApiClient.GetAllAsync()).ToList();
            await CargarAlquileres();
        }
        catch (Exception ex)
        {
            errorMessage = $"No se pudo inicializar la página: {ex.Message}";
        }
        finally
        {
            loading = false;
        }
    }

    private async Task LoadPermissions()
    {
        canRead = await AuthService.HasPermissionAsync("alquileres.leer");
        canAdd = await AuthService.HasPermissionAsync("alquileres.agregar");
        canUpdate = await AuthService.HasPermissionAsync("alquileres.actualizar");
        canDelete = await AuthService.HasPermissionAsync("alquileres.eliminar");
        canReport = await AuthService.HasPermissionAsync("reportes.leer");
    }

    private async Task CargarAlquileres()
    {
        if (!canRead) return;

        if (!FechasValidas())
        {
            loading = false;
            return;
        }

        try
        {
            loading = true;
            errorMessage = string.Empty;

            alquileres = (await AlquilerApiClient.GetByCriteriaAsync(
                fechaDesde.Date,
                fechaHasta.Date,
                sucursalId > 0 ? sucursalId : null)).ToList();

            try
            {
                var pagos = await PagoApiClient.GetAllAsync();
                alquileresConPago = pagos.Select(p => p.IdAlquiler).ToHashSet();
            }
            catch
            {
                alquileresConPago.Clear();
            }
        }
        catch
        {
            errorMessage = "No se pudieron cargar los alquileres.";
        }
        finally
        {
            loading = false;
        }
    }

    private bool FechasValidas()
    {
        if (fechaDesde.Date < new DateTime(2000, 1, 1) ||
            fechaHasta.Date < new DateTime(2000, 1, 1))
        {
            errorMessage = "Las fechas no pueden ser anteriores al 01/01/2000.";
            return false;
        }

        if (fechaDesde.Date > DateTime.Today || fechaHasta.Date > DateTime.Today)
        {
            errorMessage = "Las fechas no pueden ser futuras.";
            return false;
        }

        if (fechaDesde.Date > fechaHasta.Date)
        {
            errorMessage = "La fecha desde no puede ser posterior a la fecha hasta.";
            return false;
        }

        errorMessage = string.Empty;
        return true;
    }

    private async Task GenerarReporte()
    {
        if (!canReport || !canRead || !FechasValidas()) return;

        try
        {
            generandoReporte = true;
            errorMessage = string.Empty;

            var criteria = new ReporteAlquileresCriteriaDTO
            {
                FechaDesde = fechaDesde.Date,
                FechaHasta = fechaHasta.Date,
                SucursalId = sucursalId > 0 ? sucursalId : null
            };

            byte[] pdf = await ReporteApiClient.GetReporteAlquileresAsync(criteria);

            await JSRuntime.InvokeVoidAsync(
                "descargarArchivo",
                $"ReporteAlquileres_{DateTime.Now:yyyyMMdd_HHmm}.pdf",
                "application/pdf",
                Convert.ToBase64String(pdf));

            successMessage = "El reporte se generó y descargó correctamente.";
        }
        catch (Exception ex)
        {
            errorMessage = $"No se pudo generar el reporte: {ex.Message}";
        }
        finally
        {
            generandoReporte = false;
        }
    }

    private void NuevoAlquiler()
    {
        if (!canAdd) return;

        errorMessage = string.Empty;
        successMessage = string.Empty;
        alquilerSeleccionado = null;
        mostrarModal = true;
    }

    private void EditarAlquiler(int id)
    {
        if (!canRead) return;

        errorMessage = string.Empty;
        alquilerSeleccionado = id;
        mostrarModal = true;
    }

    private void CerrarModal()
    {
        mostrarModal = false;
        alquilerSeleccionado = null;
    }

    private async Task AlquilerGuardado()
    {
        await CargarAlquileres();
        successMessage = "El alquiler se guardó correctamente.";
    }

    private async Task LimpiarFiltros()
    {
        fechaDesde = DateTime.Today.AddMonths(-2);
        fechaHasta = DateTime.Today;
        sucursalId = 0;
        await CargarAlquileres();
    }

    private async Task CancelarAlquiler(AlquilerDTO alquiler)
    {
        if (!canUpdate || alquiler.EstadoAlquiler != EstadoDeAlquiler.Activo)
            return;

        bool confirmar = await JSRuntime.InvokeAsync<bool>(
            "confirm", $"¿Está seguro de cancelar el alquiler #{alquiler.Id}?");

        if (!confirmar) return;

        try
        {
            errorMessage = string.Empty;

            var alquilerCompleto = await AlquilerApiClient.GetAsync(alquiler.Id);

            if (alquilerCompleto.EstadoAlquiler != EstadoDeAlquiler.Activo)
            {
                errorMessage = "El alquiler ya no está activo.";
                await CargarAlquileres();
                return;
            }

            alquilerCompleto.EstadoAlquiler = EstadoDeAlquiler.Cancelado;
            await AlquilerApiClient.UpdateAsync(alquilerCompleto);
            successMessage = $"El alquiler #{alquiler.Id} se canceló correctamente.";
            await CargarAlquileres();
        }
        catch (Exception ex)
        {
            errorMessage = $"No se pudo cancelar el alquiler: {ex.Message}";
        }
    }

    private async Task EliminarAlquiler(int id)
    {
        if (!canDelete) return;

        bool confirmar = await JSRuntime.InvokeAsync<bool>(
            "confirm", $"¿Está seguro de eliminar el alquiler #{id}?");

        if (!confirmar) return;

        try
        {
            errorMessage = string.Empty;
            await AlquilerApiClient.DeleteAsync(id);
            successMessage = $"El alquiler #{id} se eliminó correctamente.";
            await CargarAlquileres();
        }
        catch (Exception ex)
        {
            errorMessage = $"No se pudo eliminar el alquiler: {ex.Message}";
        }
    }
}