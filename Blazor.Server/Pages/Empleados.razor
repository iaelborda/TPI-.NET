@page "/empleados"
@using DTOs
@using API.Clients
@using Blazor.Server.Components
@inject IJSRuntime JSRuntime
@inject IAuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Empleados</PageTitle>

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <h3>Empleados</h3>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @errorMessage
                    <button type="button" class="btn-close" @onclick="() => errorMessage = string.Empty"></button>
                </div>
            }

            @if (!string.IsNullOrEmpty(successMessage))
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @successMessage
                    <button type="button" class="btn-close" @onclick="() => successMessage = string.Empty"></button>
                </div>
            }

            @if (canAdd)
            {
                <div class="mb-3">
                    <button class="btn btn-primary" @onclick="OpenAddModal">
                        <i class="fas fa-plus"></i> Agregar
                    </button>
                </div>
            }

            @if (loading)
            {
                <div class="d-flex justify-content-center">
                    <div class="spinner-border" role="status">
                        <span class="visually-hidden">Cargando...</span>
                    </div>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>Id</th>
                                <th>Legajo</th>
                                <th>Tipo Doc.</th>
                                <th>Documento</th>
                                <th>Nombre</th>
                                <th>Apellido</th>
                                <th>Teléfono</th>
                                <th>Sucursal</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (empleados != null && empleados.Any())
                            {
                                @foreach (var empleado in empleados)
                                {
                                    <tr>
                                        <td>@empleado.Id</td>
                                        <td>@empleado.Legajo</td>
                                        <td>@empleado.TipoDocumento</td>
                                        <td>@empleado.Documento</td>
                                        <td>@empleado.Nombre</td>
                                        <td>@empleado.Apellido</td>
                                        <td>@empleado.Telefono</td>
                                        <td>@(empleado.NombreSucursal ?? "-")</td>
                                        <td>
                                            @if (canUpdate)
                                            {
                                                <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => OpenEditModal(empleado)">
                                                    <i class="fas fa-edit"></i> Editar
                                                </button>
                                            }
                                            @if (canDelete)
                                            {
                                                <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmDelete(empleado)">
                                                    <i class="fas fa-trash"></i> Eliminar
                                                </button>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="9" class="text-center text-muted">No se encontraron empleados registrados.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<EmpleadoModal @ref="empleadoModal" OnEmpleadoChanged="LoadEmpleados" />

@code {
    private List<EmpleadoDTO>? empleados;
    private bool loading = true;
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;
    private EmpleadoModal empleadoModal = null!;

    private bool canRead = false;
    private bool canAdd = false;
    private bool canUpdate = false;
    private bool canDelete = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var isAuthenticated = await AuthService.IsAuthenticatedAsync();

            if (!isAuthenticated)
            {
                Navigation.NavigateTo("/login");
                return;
            }

            await LoadPermissions();

            if (canRead)
            {
                await LoadEmpleados();
            }
            else
            {
                errorMessage = "No tiene permisos para ver empleados.";
            }

            StateHasChanged();
        }

        await base.OnAfterRenderAsync(firstRender);
    }

    private async Task LoadPermissions()
    {
        canRead = await AuthService.HasPermissionAsync("empleados.leer");
        canAdd = await AuthService.HasPermissionAsync("empleados.agregar");
        canUpdate = await AuthService.HasPermissionAsync("empleados.actualizar");
        canDelete = await AuthService.HasPermissionAsync("empleados.eliminar");
    }

    private async Task LoadEmpleados()
    {
        try
        {
            loading = true;
            empleados = (await EmpleadoApiClient.GetAllAsync())?.ToList();
            successMessage = string.Empty;
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al cargar empleados: {ex.Message}";
        }
        finally
        {
            loading = false;
        }
    }

    private async Task OpenAddModal()
    {
        await empleadoModal.ShowAddModal();
    }

    private async Task OpenEditModal(EmpleadoDTO empleado)
    {
        await empleadoModal.ShowEditModal(empleado);
    }

    private async Task ConfirmDelete(EmpleadoDTO empleado)
    {
        var confirm = await JSRuntime.InvokeAsync<bool>(
            "confirm",
            $"¿Está seguro que desea eliminar al empleado {empleado.Nombre} {empleado.Apellido} (Legajo: {empleado.Legajo})?"
        );

        if (confirm)
        {
            await DeleteEmpleado(empleado.Id);
        }
    }

    private async Task DeleteEmpleado(int id)
    {
        try
        {
            await EmpleadoApiClient.DeleteAsync(id);
            successMessage = "Empleado eliminado exitosamente.";
            await LoadEmpleados();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al eliminar empleado: {ex.Message}";
        }
    }
}
