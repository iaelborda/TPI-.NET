@page "/bicicletas"
@using DTOs
@using Domain.Model
@using API.Clients
@using Blazor.Server.Components
@inject IJSRuntime JSRuntime
@inject IAuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Bicicletas</PageTitle>

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <h3>Bicicletas</h3>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @errorMessage
                    <button type="button" class="btn-close" @onclick="() => errorMessage = string.Empty"></button>
                </div>
            }

            @if (!string.IsNullOrEmpty(successMessage))
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @successMessage
                    <button type="button" class="btn-close" @onclick="() => successMessage = string.Empty"></button>
                </div>
            }

            <!-- Botones superiores -->
            <div class="d-flex gap-2 mb-3">
                @if (canAdd)
                {
                    <button class="btn btn-primary" @onclick="OpenAddModal">
                        <i class="fas fa-plus"></i> Agregar
                    </button>
                }
                @if (canReport)
                {
                    <button class="btn btn-success" @onclick="GenerarReporte" disabled="@generandoReporte">
                        <i class="fas fa-file-pdf me-1"></i>
                        @(generandoReporte ? "Generando..." : "Reporte Top 10")
                    </button>
                }
            </div>

            <!-- Barra de filtros -->
            @if (canRead)
            {
                <div class="card mb-3 p-3 bg-light">
                    <div class="row g-2 align-items-end">
                        <div class="col-md-3">
                            <label class="form-label small">Marca o Modelo</label>
                            <input type="text" class="form-control" placeholder="Buscar texto..." @bind="filtroTexto" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small">Categoría</label>
                            <select class="form-select" @bind="filtroCategoriaId">
                                <option value="0">Todas</option>
                                @if (categorias != null)
                                {
                                    @foreach (var c in categorias)
                                    {
                                        <option value="@c.Id">@c.Descripcion</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small">Sucursal</label>
                            <select class="form-select" @bind="filtroSucursalId">
                                <option value="0">Todas</option>
                                @if (sucursales != null)
                                {
                                    @foreach (var s in sucursales)
                                    {
                                        <option value="@s.Id">@s.Nombre</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small">Estado</label>
                            <select class="form-select" @bind="filtroEstadoStr">
                                <option value="">Todos</option>
                                <option value="Disponible">Disponible</option>
                                <option value="EnUso">En Uso</option>
                                <option value="EnMantenimiento">En Mantenimiento</option>
                            </select>
                        </div>
                        <div class="col-md-3 d-flex gap-2">
                            <button class="btn btn-primary" @onclick="AplicarFiltros">
                                <i class="fas fa-search me-1"></i> Filtrar
                            </button>
                            <button class="btn btn-outline-secondary" @onclick="LimpiarFiltros">
                                <i class="fas fa-undo me-1"></i> Limpiar
                            </button>
                        </div>
                    </div>
                </div>
            }

            @if (loading)
            {
                <div class="d-flex justify-content-center">
                    <div class="spinner-border" role="status">
                        <span class="visually-hidden">Cargando...</span>
                    </div>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>Id</th>
                                <th>Marca</th>
                                <th>Modelo</th>
                                <th>Estado</th>
                                <th>Categoría</th>
                                <th>Sucursal</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (bicicletas != null && bicicletas.Any())
                            {
                                @foreach (var bicicleta in bicicletas)
                                {
                                    <tr>
                                        <td>@bicicleta.Id</td>
                                        <td>@bicicleta.Marca</td>
                                        <td>@bicicleta.Modelo</td>
                                        <td>@bicicleta.Estado</td>
                                        <td>@bicicleta.DescripcionCategoria</td>
                                        <td>@bicicleta.DireccionSucursal</td>
                                        <td>
                                            @if (canUpdate)
                                            {
                                                <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => OpenEditModal(bicicleta)">
                                                    <i class="fas fa-edit"></i> Editar
                                                </button>
                                            }
                                            @if (canDelete)
                                            {
                                                <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmDelete(bicicleta)">
                                                    <i class="fas fa-trash"></i> Eliminar
                                                </button>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="7" class="text-center text-muted py-3">No hay bicicletas registradas.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@if (mostrarVisorModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-xl modal-dialog-centered">
            <div class="modal-content" style="height: 85vh;">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="fas fa-file-pdf text-danger me-2"></i>Reporte Top 10 Bicicletas (@DateTime.Now.Year)
                    </h5>
                    <button type="button" class="btn-close" @onclick="CerrarVisorModal"></button>
                </div>
                <div class="modal-body p-0" style="height: calc(100% - 120px);">
                    <iframe src="@pdfBase64Url" style="width: 100%; height: 100%; border: none;"></iframe>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CerrarVisorModal">Cerrar</button>
                    <button class="btn btn-success" @onclick="DescargarPdf">
                        <i class="fas fa-download me-1"></i>Descargar PDF
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<BicicletaModal @ref="bicicletaModal" OnBicicletaChanged="OnBicicletaSaved" />

@code {
    private List<BicicletaDTO>? bicicletas;
    private bool loading = true;
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;
    private BicicletaModal bicicletaModal = null!;
    private bool generandoReporte;
    private bool mostrarVisorModal;
    private byte[]? pdfBytes;
    private string pdfBase64Url = string.Empty;

    // Filtros
    private string filtroTexto = string.Empty;
    private int filtroCategoriaId = 0;
    private int filtroSucursalId = 0;
    private string filtroEstadoStr = string.Empty;
    private List<CategoriaDTO> categorias = new();
    private List<SucursalDTO> sucursales = new();

    // Permisos de autorización
    private bool canRead = false;
    private bool canAdd = false;
    private bool canUpdate = false;
    private bool canDelete = false;
    private bool canReport = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var isAuthenticated = await AuthService.IsAuthenticatedAsync();
            if (!isAuthenticated)
            {
                Navigation.NavigateTo("/login");
                return;
            }

            await LoadPermissions();

            if (canRead)
            {
                try
                {
                    categorias = (await CategoriaApiClient.GetAllAsync())?.ToList() ?? new();
                    sucursales = (await SucursalApiClient.GetAllAsync())?.ToList() ?? new();
                }
                catch
                {
                }
                await LoadBicicletas();
            }
            else
            {
                errorMessage = "No tiene permisos para ver bicicletas.";
            }

            StateHasChanged();
        }
        await base.OnAfterRenderAsync(firstRender);
    }

    private async Task LoadPermissions()
    {
        canRead = await AuthService.HasPermissionAsync("bicicletas.leer");
        canAdd = await AuthService.HasPermissionAsync("bicicletas.agregar");
        canUpdate = await AuthService.HasPermissionAsync("bicicletas.actualizar");
        canDelete = await AuthService.HasPermissionAsync("bicicletas.eliminar");
        canReport = await AuthService.HasPermissionAsync("reportes.leer");
    }

    private async Task LoadBicicletas()
    {
        try
        {
            loading = true;
            bicicletas = (await BicicletaApiClient.GetAllAsync())?.ToList();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al cargar bicicletas: {ex.Message}";
        }
        finally
        {
            loading = false;
        }
    }

    private async Task AplicarFiltros()
    {
        try
        {
            loading = true;

            EstadoBicicleta? estadoEnum = null;
            if (!string.IsNullOrEmpty(filtroEstadoStr) && Enum.TryParse<EstadoBicicleta>(filtroEstadoStr, out var est))
            {
                estadoEnum = est;
            }

            var criteria = new BicicletaCriteriaDTO
            {
                Busqueda = string.IsNullOrWhiteSpace(filtroTexto) ? null : filtroTexto,
                CategoriaId = filtroCategoriaId > 0 ? filtroCategoriaId : null,
                SucursalId = filtroSucursalId > 0 ? filtroSucursalId : null,
                Estado = estadoEnum
            };

            bicicletas = (await BicicletaApiClient.GetByCriteriaAsync(criteria))?.ToList();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al filtrar bicicletas: {ex.Message}";
        }
        finally
        {
            loading = false;
        }
    }

    private async Task LimpiarFiltros()
    {
        filtroTexto = string.Empty;
        filtroCategoriaId = 0;
        filtroSucursalId = 0;
        filtroEstadoStr = string.Empty;
        await LoadBicicletas();
    }

    private async Task OnBicicletaSaved()
    {
        successMessage = "Operación realizada exitosamente.";
        await LoadBicicletas();
    }

    private async Task OpenAddModal()
    {
        await bicicletaModal.ShowAddModal();
    }

    private async Task OpenEditModal(BicicletaDTO bicicleta)
    {
        await bicicletaModal.ShowEditModal(bicicleta);
    }

    private async Task ConfirmDelete(BicicletaDTO bicicleta)
    {
        var confirm = await JSRuntime.InvokeAsync<bool>("confirm",
            $"¿Está seguro que desea eliminar la bicicleta {bicicleta.Marca} {bicicleta.Modelo} (Id: {bicicleta.Id})?");

        if (confirm)
        {
            await DeleteBicicleta(bicicleta.Id);
        }
    }

    private async Task DeleteBicicleta(int id)
    {
        try
        {
            await BicicletaApiClient.DeleteAsync(id);
            successMessage = "Bicicleta eliminada exitosamente.";
            await LoadBicicletas();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al eliminar Bicicleta: {ex.Message}";
        }
    }

    private async Task GenerarReporte()
    {
        if (!canReport) return;
        try
        {
            generandoReporte = true;
            pdfBytes = await ReporteApiClient.GetTop10BicicletasAnioAsync();
            pdfBase64Url = $"data:application/pdf;base64,{Convert.ToBase64String(pdfBytes)}";
            mostrarVisorModal = true;
        }
        catch (Exception ex)
        {
            errorMessage = $"No se pudo generar el reporte: {ex.Message}";
        }
        finally
        {
            generandoReporte = false;
        }
    }

    private void CerrarVisorModal()
    {
        mostrarVisorModal = false;
        pdfBase64Url = string.Empty;
    }

    private async Task DescargarPdf()
    {
        if (pdfBytes == null) return;

        await JSRuntime.InvokeVoidAsync(
            "descargarArchivo",
            $"Top10Bicicletas_{DateTime.Now.Year}_{DateTime.Now:yyyyMMdd_HHmm}.pdf",
            "application/pdf",
            Convert.ToBase64String(pdfBytes));
    }
}
