@page "/categorias"
@using DTOs
@using API.Clients
@using Blazor.Server.Components
@inject IJSRuntime JSRuntime
@inject IAuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Categorias</PageTitle>

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <h3>Categorias</h3>
            
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @errorMessage
                    <button type="button" class="btn-close" @onclick="() => errorMessage = string.Empty"></button>
                </div>
            }
            
            @if (!string.IsNullOrEmpty(successMessage))
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @successMessage
                    <button type="button" class="btn-close" @onclick="() => successMessage = string.Empty"></button>
                </div>
            }

            @if (canAdd)
            {
                <div class="mb-3">
                    <button class="btn btn-primary" @onclick="OpenAddModal">
                        <i class="fas fa-plus"></i> Agregar
                    </button>
                </div>
            }

            @if (loading)
            {
                <div class="d-flex justify-content-center">
                    <div class="spinner-border" role="status">
                        <span class="visually-hidden">Cargando...</span>
                    </div>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>Id</th>
                                <th>Descripcion</th>
                                <th>Tarifa Vigente</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (categorias != null && categorias.Any())
                            {
                                @foreach (var categoria in categorias)
                                {
                                    <tr>
                                        <td>@categoria.Id</td>
                                        <td>@categoria.Descripcion</td>
                                        <td>@categoria.PrecioHoraVigente</td>
                                        <td>
                                            @if (canUpdate)
                                            {
                                                <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => OpenEditModal(categoria)">
                                                    <i class="fas fa-edit"></i> Editar
                                                </button>
                                            }
                                            @if (canDelete)
                                            {
                                                <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmDelete(categoria)">
                                                    <i class="fas fa-trash"></i> Eliminar
                                                </button>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<CategoriaModal @ref="categoriaModal" OnCategoriaChanged="LoadCategorias" />

@code {
    private List<CategoriaDTO>? categorias;
    private bool loading = true;
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;
    private CategoriaModal categoriaModal = null!;
    
    // Permisos de autorización
    private bool canRead = false;
    private bool canAdd = false;
    private bool canUpdate = false;
    private bool canDelete = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Verificar autenticación antes de cargar datos
            var isAuthenticated = await AuthService.IsAuthenticatedAsync();
            if (!isAuthenticated)
            {
                Navigation.NavigateTo("/login");
                return;
            }

            // Verificar permisos
            await LoadPermissions();
            
            // Solo cargar datos si tiene permiso de lectura
            if (canRead)
            {
                await LoadCategorias();
            }
            else
            {
                errorMessage = "No tiene permisos para ver categorias.";
            }
            
            StateHasChanged();
        }
        await base.OnAfterRenderAsync(firstRender);
    }

    private async Task LoadPermissions()
    {
        canRead = await AuthService.HasPermissionAsync("categorias.leer");
        canAdd = await AuthService.HasPermissionAsync("categorias.agregar");
        canUpdate = await AuthService.HasPermissionAsync("categorias.actualizar");
        canDelete = await AuthService.HasPermissionAsync("categorias.eliminar");
    }

    private async Task LoadCategorias()
    {
        try
        {
            loading = true;
            categorias = (await CategoriaApiClient.GetAllAsync())?.ToList();
            successMessage = string.Empty; // Clear success message when reloading
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al cargar categorias: {ex.Message}";
        }
        finally
        {
            loading = false;
        }
    }

    private void OpenAddModal()
    {
        categoriaModal.ShowAddModal();
    }

    private void OpenEditModal(CategoriaDTO categoria)
    {
        categoriaModal.ShowEditModal(categoria);
    }

    private async Task ConfirmDelete(CategoriaDTO categoria)
    {
        var confirm = await JSRuntime.InvokeAsync<bool>("confirm", 
            $"¿Está seguro que desea eliminar la categoria {categoria.Descripcion} (Id: {categoria.Id})?");
        
        if (confirm)
        {
            await DeleteCategoria(categoria.Id);
        }
    }

    private async Task DeleteCategoria(int id)
    {
        try
        {
            await CategoriaApiClient.DeleteAsync(id);
            successMessage = "Categoria eliminada exitosamente.";
            await LoadCategorias();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al eliminar categoria: {ex.Message}";
        }
    }
}